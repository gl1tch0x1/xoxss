# =============================================================================
# XOXSS Scanner Configuration Template (.env.example)
# =============================================================================
# Copy this file to '.env' or '.config' and populate with your own API keys:
#   cp .env.example .env
#
# NOTE: Do NOT commit '.env' or '.config' containing real keys to public git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM Semantic Triage & Verification Pipeline (--hybrid, --oracle-verify)
# -----------------------------------------------------------------------------
# Provider: openai, gemini, anthropic, ollama (leave empty for auto-detection based on API key)
XOXSS_LLM_PROVIDER=

# Model identifier (leave empty to use provider default: gpt-4o-mini, gemini-2.5-flash, claude-3-5-sonnet-latest, or llama3.2)
XOXSS_LLM_MODEL=

# Universal LLM API key override (if set, applies to any provider)
XOXSS_LLM_KEY=

# Provider-Specific API Keys:
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Custom LLM API endpoint base URL (for local Ollama, vLLM, LocalAI, or custom OpenAI proxies)
# Example for Ollama: http://localhost:11434/v1/chat/completions
XOXSS_LLM_ENDPOINT=

# -----------------------------------------------------------------------------
# 2. AI Fallback Payload Generation (--ai, --ai-only)
# -----------------------------------------------------------------------------
# API key for OpenRouter or DeepSeek payload synthesis
XOXSS_AI_KEY=
OPENROUTER_API_KEY=
XSSR_AI_KEY=

# Model identifier for AI payload generation (default: deepseek/deepseek-chat)
XOXSS_AI_MODEL=deepseek/deepseek-chat

# Custom AI completions URL (default: https://openrouter.ai/api/v1/chat/completions)
XOXSS_AI_URL=https://openrouter.ai/api/v1/chat/completions

# -----------------------------------------------------------------------------
# 3. Reconnaissance & OSINT Intelligence API Keys
# -----------------------------------------------------------------------------
# urlscan.io API key for historic URL indexing & DOM search
URLSCAN_API_KEY=

# AlienVault OTX API key for passive DNS and threat indicators
OTX_API_KEY=

# SecurityTrails API key for passive subdomain enumeration
SECURITYTRAILS_API_KEY=

# Shodan API key for host intelligence and service reconnaissance
SHODAN_API_KEY=

# GitHub Personal Access Token for scanning public source leaks & endpoints
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# 4. Out-of-Band (OAST) / Blind XSS Callbacks
# -----------------------------------------------------------------------------
# Custom interactsh server domain (default: oast.pro)
INTERACTSH_SERVER=oast.pro

# Authentication token for private/self-hosted interactsh server (if required)
INTERACTSH_TOKEN=

# Generic HTTP/NDJSON collector polling URL (e.g. XSS Hunter, Burp Collaborator)
XOXSS_OOB_POLL=

# Collector authentication / authorization key
XOXSS_OOB_KEY=

# -----------------------------------------------------------------------------
# 5. Browser Automation & Environment Settings
# -----------------------------------------------------------------------------
# Explicit path to Chromium / Chrome executable (overrides automatic discovery)
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux example:   /usr/bin/chromium
XOXSS_CHROMIUM=
CHROME_BIN=
CHROMIUM_BIN=

# AST parsing engine (tree-sitter or regex fallback)
XOXSS_AST_BACKEND=auto

# Custom temporary working directory for payload downloads and scratch files
XOXSS_TMPDIR=

# Proxy configurations (applied when --proxy is not passed via CLI)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Disable ANSI color output in terminal logs (set to 1 to disable)
NO_COLOR=
