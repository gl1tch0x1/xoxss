{
  "schema": 2,
  "purpose": "repeatable authorized XSS coverage and false-positive benchmark",
  "base_url": "http://127.0.0.1:8765",
  "cases": [
    {"id": "reflected-html-text", "class": "reflected", "context": "html-text", "url": "/reflected?q=hello", "expect": "finding", "expected": "confirmed-or-high"},
    {"id": "reflected-html-attribute", "class": "reflected", "context": "quoted-attribute", "url": "/attribute?q=hello", "expect": "finding", "expected": "confirmed-or-high"},
    {"id": "reflected-script-string", "class": "reflected", "context": "javascript-string", "url": "/script?q=hello", "expect": "finding", "expected": "confirmed-or-high"},
    {"id": "reflected-json", "class": "reflected", "context": "json-script", "url": "/api/search?q=hello", "expect": "none", "expected": "candidate-with-context-evidence"},
    {"id": "dom-location-search", "class": "dom", "source": "location.search", "sink": "innerHTML", "url": "/dom-query?q=hello", "expect": "finding", "browser": true, "expected": "runtime-sink-or-execution"},
    {"id": "dom-location-hash", "class": "dom", "source": "location.hash", "sink": "insertAdjacentHTML", "url": "/dom-hash", "expect": "finding", "browser": true, "expected": "runtime-sink-or-execution"},
    {"id": "dom-local-storage", "class": "dom", "source": "localStorage", "sink": "innerHTML", "url": "/dom-storage", "expect": "finding", "browser": true, "dom_source_probes": true, "expected": "runtime-sink-or-execution"},
    {"id": "dom-session-storage", "class": "dom", "source": "sessionStorage", "sink": "outerHTML", "url": "/dom-session-storage", "expect": "finding", "browser": true, "dom_source_probes": true, "expected": "runtime-sink-or-execution"},
    {"id": "dom-window-name", "class": "dom", "source": "window.name", "sink": "document.write", "url": "/dom-window-name", "expect": "finding", "browser": true, "dom_source_probes": true, "expected": "runtime-sink-or-execution"},
    {"id": "dom-postmessage", "class": "dom", "source": "message.data", "sink": "DOMParser.parseFromString", "url": "/dom-message", "expect": "finding", "browser": true, "dom_source_probes": true, "expected": "runtime-sink-or-execution"},
    {"id": "stored-user-content", "class": "stored", "context": "admin-or-rendered-view", "url": "/stored", "expect": "finding", "browser": true, "stored": true, "expected": "confirmed-after-second-request"},
    {"id": "authenticated-route", "class": "access-control", "context": "Playwright-storage-state", "url": "/auth/search?q=hello", "cookie": "benchmark_session=authorized", "expect": "finding", "expected": "route-discovered-and-scanned"},
    {"id": "escaped-reflection-control", "class": "negative", "context": "html-escaped", "url": "/escaped?q=hello", "expect": "none", "expected": "no-confirmed-xss"},
    {"id": "sanitized-dom-control", "class": "negative", "context": "trusted-sanitizer", "url": "/dom-sanitized?q=hello", "expect": "none", "browser": true, "expected": "no-confirmed-xss"},
    {"id": "static-token-control", "class": "negative", "context": "non-executable-reflection", "url": "/static", "expect": "none", "expected": "no-confirmed-xss"}
  ]
}
